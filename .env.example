# The Eurasian Bridge — Environment Variables
# =============================================
# Copy this file to .env and adjust as needed.
# These are OPTIONAL overrides; the app works without them.

# Sentry APM integration (optional for error tracking)
# SENTRY_DSN=https://example@o123.ingest.sentry.io/456

# Sentry trace sampling rate for performance monitoring (default: 0.1, allowed: 0.0-1.0)
# BM_SENTRY_TRACE_SAMPLE_RATE=0.1

# MOEX ISS API timeout in seconds (default: 15, allowed: 1-120)
# BM_TIMEOUT=15

# MOEX data delay in days — how many days behind today MOEX data typically is (default: 2, allowed: 1-14)
# BM_MOEX_DELAY=2
